# ---------- Build stage ----------
FROM node:22-alpine AS builder
WORKDIR /app/backend

# 国内网络镜像：必须在 npm install 之前设置，否则 Prisma 安装期的 engine 二进制下载
# 会走默认跨境源 binaries.prisma.sh 而 ECONNRESET（@prisma/engines 的 postinstall 在 install 阶段触发）
ENV PRISMA_ENGINES_MIRROR=https://npmmirror.com/mirrors/prisma
# 先装依赖（利用层缓存）
COPY backend/package.json backend/package-lock.json* ./
# 国内网络：npm 默认注册表跨境不稳定，切 npmmirror 镜像（与 OCR 用阿里云 pip 镜像同理）
RUN npm config set registry https://registry.npmmirror.com/ \
    && npm install --omit=dev=false --registry=https://registry.npmmirror.com/ --fetch-timeout=120000 --fetch-retries=5

# 再拷源码并构建
COPY backend/ ./
# 用国内镜像下载 Prisma engine（binaries.prisma.sh 跨境访问不稳定，易 TLS 断开）
RUN node_modules/.bin/prisma generate
RUN npm run build
# 将 seed.ts 预编译为 CommonJS 的 seed.js（输出到 prisma/ 目录，与 cwd /app/backend 相对）。
# 原因：容器内用 ts-node 直接跑 seed.ts 会因 TS 版本/配置解析差异报
# TS5109(module 必须 NodeNext) 而失败；改为构建期预编译、运行时 node 直跑，绕开 ts-node。
RUN node_modules/.bin/tsc prisma/seed.ts --outDir prisma \
    --module commonjs --moduleResolution node --esModuleInterop \
    --skipLibCheck --resolveJsonModule --target ES2021

# ---------- Runtime stage ----------
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
# 运行时也需镜像：migrate deploy / PrismaClient 首次加载会校验 engine 的 .sha256，
# 不设镜像会回退到跨境 binaries.prisma.sh 而 TLS 断开；与构建期保持一致。
ENV PRISMA_ENGINES_MIRROR=https://npmmirror.com/mirrors/prisma

# poppler-utils: PDF 转图（OCR 预处理）
# openssl: Prisma 在 alpine 需要
RUN apk add --no-cache poppler-utils openssl

# 仅生产依赖
COPY --from=builder /app/backend/node_modules ./backend/node_modules
COPY --from=builder /app/backend/dist ./backend/dist
COPY --from=builder /app/backend/prisma ./backend/prisma
COPY --from=builder /app/backend/package.json ./backend/package.json
COPY --from=builder /app/backend/node_modules/.prisma ./backend/node_modules/.prisma

WORKDIR /app/backend
EXPOSE 3000

# 启动前：① 执行迁移（首次建表，之后幂等）② 写入种子数据（admin/角色/权限，幂等 upsert）③ 起服务
# 注意：seed 用预编译的 seed.js（构建期 tsc 生成），不再用 ts-node，避免 TS5109。
CMD ["sh", "-c", "node_modules/.bin/prisma migrate deploy && node prisma/seed.js && node dist/main.js"]
